{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.SilentMesh-Systems/Lure",
  "description": "Plant fake credentials and get alerted when an attacker uses one. Stdlib-only, never returns passwords.",
  "repository": {
    "url": "https://github.com/SilentMesh-Systems/Lure",
    "source": "github"
  },
  "version": "0.1.0b1",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "silentmesh-lure",
      "version": "0.1.0b1",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
